{
  "account_name": "Fidelity Account",
  "login_url": "https://digital.fidelity.com/prgw/digital/login/full-page",
  "positions_url": "https://digital.fidelity.com/ftgw/digital/portfolio/positions",
  "output_file": "positions.fidelity.json",
  "chrome": {
    "debug_port": 9222,
    "profile_dir": "chrome-profile",
    "path": "",
    "start_url": ""
  },
  "signed_in": {
    "grid_selector": ".ag-root, [role='grid'], table",
    "marker_selector": ".ag-center-cols-container, .acct-selector__acct-num",
    "url_contains": "/ftgw/digital/"
  },
  "sign_in_timeout_seconds": 300,
  "grid_timeout_seconds": 90,
  "columns": {
    "symbol": [
      "sym",
      "symbol",
      "ticker"
    ],
    "quantity": [
      "qty",
      "quantity",
      "shares"
    ],
    "market_value": [
      "curVal",
      "current value",
      "market value",
      "value"
    ],
    "unrealized_pnl": [
      "totGLStk",
      "total gain/loss dollar",
      "total gain/loss",
      "unrealized gain/loss"
    ]
  },
  "skip_row_pattern": "(?i)\\b(total|subtotal|pending activity)\\b",
  "row_patterns": {
    "account": "^Account:\\s*(.+)$",
    "cash": "^Cash\\b",
    "account_total": "^Account total\\b",
    "grand_total": "^Grand total\\b",
    "empty_account": "^You do not hold any positions"
  },
  "account_number": "([A-Z]?\\d{5,}[A-Z0-9-]*)$",
  "account_link_text": "(Manage dividends|Option summary|Manage Dividends)",
  "sign_in": {
    "username": [
      "#dom-username-input",
      "#userId-input",
      "input[autocomplete='username']"
    ],
    "password": [
      "#dom-pswd-input",
      "#password",
      "input[type='password']"
    ],
    "submit": [
      "#dom-login-button",
      "#fs-login-button",
      "button[type='submit']"
    ],
    "error": [
      "#dom-sys-err-go-to-login-button"
    ]
  },
  "keyring_service": "fidelity-holdings",
  "account_name_columns": [
    "account name"
  ],
  "account_number_columns": [
    "account number"
  ],
  "delays": {
    "before_typing_seconds": 1.5,
    "per_character_seconds": 0.08,
    "between_fields_seconds": 0.8,
    "before_submit_seconds": 1.2,
    "after_sign_in_seconds": 3.0,
    "after_page_load_seconds": 2.0,
    "scroll_step_seconds": 0.6,
    "form_wait_seconds": 20
  },
  "csv_watch_dirs": [
    "~/Downloads",
    "downloads"
  ],
  "csv_patterns": [
    "Portfolio_Positions*.csv",
    "*Positions*.csv"
  ],
  "watch_poll_seconds": 3
}
