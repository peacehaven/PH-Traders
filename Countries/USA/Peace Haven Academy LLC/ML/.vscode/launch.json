{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Find the positions table (--dump-tables)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/broker_positions.py",
      "args": ["--dump-tables"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "2. Get positions -> positions.json",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/broker_positions.py",
      "args": ["--out", "positions.json"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "3. Get positions (headless, verbose)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/broker_positions.py",
      "args": ["--headless", "--verbose", "--out", "positions.json"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
