{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Get holdings",
      "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/fidelity.py",
      "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    },
    {
      "name": "2. Get holdings (verbose)",
      "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/fidelity.py",
      "args": ["-v"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    },
    {
      "name": "Save my login (once)",
      "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/fidelity.py",
      "args": ["--save-login"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    },
    {
      "name": "Check my stored login",
      "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/fidelity.py",
      "args": ["--check-login"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    },
    {
      "name": "Read the CSV file I have open",
      "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/fidelity.py",
      "args": ["--csv", "${file}"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    },
    {
      "name": "Watch downloads for a new CSV",
      "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/fidelity.py",
      "args": ["--watch"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    }
  ]
}
